<!-- pages/settings/settings.wxml 设置 -->
<view class="page">

  <!-- AI 状态 -->
  <view class="card">
    <view class="card-title">AI 服务状态</view>
    <view class="status-row">
      <view class="status-dot {{aiEnabled ? 'on' : ''}}"></view>
      <text class="status-text">{{aiEnabled ? '已开启 · AI 智能生效中' : '未配置 · 当前为兜底模式'}}</text>
    </view>
    <view class="status-detail" wx:if="{{!aiEnabled}}">兜底模式下记账、熟客、查账仍可用，但智能解析与提醒功能受限。</view>
    <view class="status-detail">服务地址：{{baseUrl}}</view>
    <view class="status-detail">模型：{{model}}</view>
  </view>

  <!-- 模型配置 -->
  <view class="card">
    <view class="card-title">AI 模型配置</view>
    <view class="form-item">
      <text class="form-label">选择大模型</text>
      <picker bindchange="onProviderChange" value="{{providerIndex}}" range="{{providerNames}}">
        <view class="picker-value">{{providerNames[providerIndex] || '点击选择'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">{{keyLabel}}</text>
      <input class="form-input" password="{{true}}" placeholder="粘贴你的 API Key"
             value="{{apiKey}}" bindinput="onApiKeyInput" />
    </view>
    <view class="form-item">
      <text class="form-label">Base URL（已自动填充，可改）</text>
      <input class="form-input" placeholder="https://api.deepseek.com"
             value="{{baseUrl}}" bindinput="onBaseUrlInput" />
    </view>
    <view class="form-item">
      <text class="form-label">模型（已自动填充，可改）</text>
      <input class="form-input" placeholder="deepseek-chat"
             value="{{model}}" bindinput="onModelInput" />
    </view>
    <view class="btn-primary manual-btn {{saving ? 'btn-disabled' : ''}}" bindtap="save">保存并启用</view>
    <view class="btn-ghost mt-btn" wx:if="{{hasKey}}" bindtap="clearKey">清除 API Key</view>
    <view class="howto" bindtap="howToGet">还没有 Key？去对应平台开通（复制链接）</view>
  </view>

  <!-- 说明 -->
  <view class="card">
    <view class="card-title">说明</view>
    <view class="howto-text">1. 支持多家大模型（DeepSeek/OpenAI/通义千问/智谱/Kimi），选好后填对应的 API Key 即可。</view>
    <view class="howto-text">2. Key 只保存在你自己的电脑上，不会上传。</view>
    <view class="howto-text">3. 保存后立即生效，无需重启后端服务。</view>
    <view class="howto-text">4. 语音记账还需正式小程序 AppID 并授权「同声传译」插件，与 API Key 无关。</view>
  </view>

  <tabbar current="{{4}}" />
</view>