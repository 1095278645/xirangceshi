/* pages/copy/copy.wxss */
.form-item {
  margin-bottom: 26rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #a08d7b;
  margin-bottom: 10rpx;
}

.form-input {
  background: #faf6f0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.picker-value {
  background: #faf6f0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  background: #faf6f0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.generate-btn {
  margin-top: 10rpx;
}

.result-card {
  border-left: 8rpx solid #e07b39;
}

.result-text {
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  background: #fff6ec;
  border-radius: 12rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
}