/* pages/index/index.wxss */
.hero {
  background: linear-gradient(135deg, #b4532a, #e07b39);
  padding: 40rpx 30rpx 100rpx;
  color: #fff;
  border-radius: 0 0 40rpx 40rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.summary-row {
  display: flex;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #b4532a;
}

.summary-label {
  font-size: 24rpx;
  color: #a08d7b;
  margin-top: 6rpx;
}

/* 语音按钮 */
.voice-card {
  margin: -60rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(180, 83, 42, 0.12);
}

.voice-hint {
  font-size: 26rpx;
  color: #a08d7b;
  margin-bottom: 20rpx;
}

.recording-hint {
  color: #e07b39;
}

.voice-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e07b39, #c9642a);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  box-shadow: 0 8rpx 24rpx rgba(224, 123, 57, 0.35);
}

.voice-btn .mic-icon {
  font-size: 64rpx;
}

.pulse {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.voice-result {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #4a3a2e;
  background: #fff7f0;
  border-radius: 12rpx;
  padding: 16rpx;
}

/* 解析结果 */
.parsed-grid {
  display: flex;
  flex-direction: column;
}

.parsed-item {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5ede4;
}

.parsed-label {
  width: 120rpx;
  color: #a08d7b;
  font-size: 28rpx;
}

.parsed-value {
  font-size: 28rpx;
  font-weight: 500;
}

/* 手动输入 */
.manual-input {
  width: 100%;
  height: 120rpx;
  background: #faf6f0;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.manual-btn {
  margin-top: 20rpx;
}