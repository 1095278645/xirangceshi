/* pages/index/index.wxss */
/* 连不上后端时的常驻提示条：要显眼，让演示时一眼看出是配置问题 */
.conn-warn {
  border-left: 8rpx solid #d9534f;
  background: #fff6f5;
}

.hero {
  background: linear-gradient(135deg, #b4532a, #e07b39);
  padding: 40rpx 30rpx 100rpx;
  color: #fff;
  border-radius: 0 0 40rpx 40rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.summary-row {
  display: flex;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #b4532a;
}

.summary-num.income {
  color: #2e9e5b;
}

.summary-num.expense {
  color: #d64545;
}

.summary-num.balance {
  color: #b4532a;
}

.summary-label {
  font-size: 24rpx;
  color: #a08d7b;
  margin-top: 6rpx;
}

/* 语音按钮 */
.voice-card {
  margin: -60rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(180, 83, 42, 0.12);
}

.voice-hint {
  font-size: 26rpx;
  color: #a08d7b;
  margin-bottom: 20rpx;
}

.recording-hint {
  color: #e07b39;
}

.voice-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e07b39, #c9642a);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  box-shadow: 0 8rpx 24rpx rgba(224, 123, 57, 0.35);
}

.voice-btn .mic-icon {
  font-size: 64rpx;
}

.voice-btn-disabled {
  background: #d8cfc6;
  box-shadow: none;
}

.pulse {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.voice-result {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #4a3a2e;
  background: #fff7f0;
  border-radius: 12rpx;
  padding: 16rpx;
}

/* 收支类型徽章 */
.type-wrap {
  display: inline-block;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
}

.badge-income {
  background: #e6f6ec;
  color: #2e9e5b;
}

.badge-expense {
  background: #fdeaea;
  color: #d64545;
}

.voucher-no {
  color: #8a6a4a;
  font-size: 26rpx;
}

/* 解析结果 */
.parsed-grid {
  display: flex;
  flex-direction: column;
}

.parsed-item {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5ede4;
}

.parsed-label {
  width: 120rpx;
  color: #a08d7b;
  font-size: 28rpx;
}

.parsed-value {
  font-size: 28rpx;
  font-weight: 500;
}

/* ---- 缺金额追问（AI 没听懂金额时，不落库先问） ---- */
.ask-card { border: 2rpx solid #e8b48a; background: #fffaf5; }
.ask-why { font-size: 25rpx; color: #a08d7b; line-height: 1.7; margin-bottom: 12rpx; }
.ask-strong { color: #b4532a; font-weight: 600; }
.ask-row { display: flex; align-items: center; margin-top: 16rpx; }
.ask-input {
  flex: 1; border: 1rpx solid #e5ded7; border-radius: 12rpx;
  padding: 18rpx; font-size: 30rpx; background: #fff;
}
.ask-btn {
  margin-left: 16rpx; background: #b4532a; color: #fff; font-size: 29rpx;
  font-weight: 600; padding: 18rpx 38rpx; border-radius: 12rpx;
}
.ask-cancel { text-align: center; font-size: 25rpx; color: #a08d7b; margin-top: 18rpx; }
/* 多笔缺金额：把缺的几笔列清楚 */
.ask-missing { background: #fff; border-radius: 10rpx; padding: 12rpx 16rpx; margin-bottom: 10rpx; }
.ask-missing-item { font-size: 24rpx; color: #7a6a5c; line-height: 1.8; }

/* ---- 我这么记的，对吗？（记完当场核对 + 就地更正） ---- */
.recorded-card { border-left: 8rpx solid #b4532a; }
/* 多笔时每条之间用细线隔开，避免看成一整条 */
.rec-item-row { padding: 12rpx 0; border-bottom: 1rpx solid #f5ede4; }
.rec-item-row:last-child { border-bottom: none; padding-bottom: 0; }
.rec-line { display: flex; align-items: baseline; margin: 8rpx 0 6rpx; }
.rec-amount { font-size: 46rpx; font-weight: 700; margin-right: 16rpx; }
.rec-amount.in { color: #2e9e5b; }
.rec-amount.out { color: #d64545; }
.rec-item { font-size: 28rpx; color: #3d2c1e; }
.rec-meta { font-size: 25rpx; color: #a08d7b; line-height: 1.7; }
.rec-note { color: #b4532a; }
.rec-actions { margin-top: 14rpx; }
.rec-fix {
  display: inline-block; font-size: 25rpx; color: #b4532a;
  border: 1rpx solid #b4532a; border-radius: 10rpx; padding: 10rpx 22rpx;
}

/* 手动输入 */
.manual-input {
  width: 100%;
  height: 120rpx;
  background: #faf6f0;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.manual-btn {
  margin-top: 20rpx;
}

/* 掌柜今日复盘 */
.review-card { border-left: 8rpx solid #b4532a; }
.review-head { display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 10rpx; }
.review-again { font-size: 23rpx; color: #b4532a; border: 1rpx solid #b4532a;
  border-radius: 20rpx; padding: 6rpx 16rpx; }
.review-again.busy { color: #a08d7b; border-color: #e0d3c6; }
.review-box {
  font-size: 27rpx;
  line-height: 1.8;
  color: #4a3a2c;
  padding: 4rpx 0;
  word-break: break-all;
}
.review-wait { font-size: 25rpx; color: #a08d7b; line-height: 1.7; padding: 6rpx 0; }

/* 技能卡片：掌柜今天盯什么 */
.skill-list { margin-top: 12rpx; display: flex; flex-direction: column; gap: 10rpx; }

.feedback-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.feedback-btn {
  flex: 1;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f7f1e8;
  color: #7a5c43;
  font-size: 24rpx;
}
.skill-card { background: #faf5f1; border-radius: 12rpx; padding: 14rpx 16rpx;
  border-left: 6rpx solid #d9c4a9; }
.skill-card.skill-high { border-left-color: #c0392b; }
.skill-card.skill-medium { border-left-color: #e67e22; }
.skill-card.skill-low { border-left-color: #27ae60; }
.skill-name { font-size: 24rpx; font-weight: 600; color: #6b4f3a; margin-bottom: 4rpx; }
.skill-summary { font-size: 26rpx; color: #4a3a2c; line-height: 1.6; }

/* 展开"掌柜看到的原始事实" */
.snap-toggle { font-size: 24rpx; color: #b4532a; margin-top: 16rpx; }
.snap-box { margin-top: 12rpx; background: #faf5f1; border-radius: 12rpx; padding: 16rpx; }
.snap-line { font-size: 23rpx; color: #7a6a5c; line-height: 1.8; }
.snap-note { font-size: 21rpx; color: #a08d7b; margin-top: 10rpx; line-height: 1.6; }
