<!-- pages/index/index.wxml 语音记账 -->
<view class="page">

  <!-- 问候 -->
  <view class="hero">
    <view class="hero-title">老板，今天辛苦啦！</view>
    <view class="hero-sub">{{shopName}} · AI掌柜已就位</view>
  </view>

  <!-- 连不上后端：常驻提示，点一下直接去设置页配地址 -->
  <view class="card conn-warn" wx:if="{{connBroken}}" bindtap="goSettings">
    <view class="card-title">⚠️ 连不上后端</view>
    <view class="status-detail">当前地址：{{serverAddr || '未设置'}}</view>
    <view class="status-detail">点这里去「设置」页填写电脑的局域网地址，并点「测试连接」自检。</view>
  </view>

  <!-- 掌柜今日复盘（五位伙计各管一摊 → 掌柜裁决；可展开原始事实查证） -->
  <view class="card review-card" wx:if="{{review || reviewBusy}}">
    <view class="review-head">
      <view class="card-title">🏮 掌柜今日复盘</view>
      <view class="review-again {{reviewBusy ? 'busy' : ''}}" bindtap="reviewNow">
        {{reviewBusy ? '掌柜在看账…' : '让掌柜再看一遍'}}
      </view>
    </view>
    <view class="review-box" wx:if="{{layer1 || review}}">{{layer1 || review}}</view>
    <view class="review-wait" wx:else>五位伙计正在各自看账（账目·熟客·库存·票税·监察），约 10 秒…</view>

    <view class="skill-list" wx:if="{{skills.length > 0}}">
      <view class="skill-card skill-{{item.severity}}" wx:for="{{skills}}" wx:key="id">
        <view class="skill-name">{{item.name}}</view>
        <view class="skill-summary">{{item.summary}}</view>
      </view>
    </view>

    <view class="snap-toggle" wx:if="{{layer2 || review}}" bindtap="toggleDetail">
      {{detailOpen ? '收起' : '展开看为什么'}} ▾
    </view>
    <view class="snap-box" wx:if="{{detailOpen}}">
      <view class="snap-line">{{layer2 || review}}</view>
    </view>

    <view class="snap-toggle" wx:if="{{snapshot}}" bindtap="toggleSnap">
      {{snapOpen ? '收起' : '掌柜看到的原始事实'}} ▾
    </view>
    <view class="snap-box" wx:if="{{snapOpen}}">
      <view class="snap-line" wx:for="{{snapshotLines}}" wx:key="index">{{item}}</view>
      <view class="snap-note">结论都是从这些事实里挑出来的；没记的经营动作也会出现在这里。</view>
    </view>
  </view>

  <!-- 今日汇总 -->
  <view class="card">
    <view class="card-title">今日账本</view>
    <view class="summary-row">
      <view class="summary-item">
        <view class="summary-num income">{{summary.income}}</view>
        <view class="summary-label">收入（元）</view>
      </view>
      <view class="summary-item">
        <view class="summary-num expense">{{summary.expense}}</view>
        <view class="summary-label">支出（元）</view>
      </view>
      <view class="summary-item">
        <view class="summary-num balance">{{summary.balance}}</view>
        <view class="summary-label">结余（元）</view>
      </view>
      <view class="summary-item">
        <view class="summary-num">{{summary.cnt}}</view>
        <view class="summary-label">笔数</view>
      </view>
    </view>
  </view>

  <!-- 本月账本 -->
  <view class="card">
    <view class="card-title">本月账本 · {{month.period}}</view>
    <view class="summary-row">
      <view class="summary-item">
        <view class="summary-num income">{{month.income}}</view>
        <view class="summary-label">收入（元）</view>
      </view>
      <view class="summary-item">
        <view class="summary-num expense">{{month.expense}}</view>
        <view class="summary-label">支出（元）</view>
      </view>
      <view class="summary-item">
        <view class="summary-num balance">{{month.balance}}</view>
        <view class="summary-label">结余（元）</view>
      </view>
    </view>
  </view>

  <!-- 语音记账 -->
  <view class="voice-card {{recognizing ? 'recording' : ''}}">
    <view class="voice-hint" wx:if="{{!voiceEnabled}}">语音功能需正式AppID授权，请用下方手动输入</view>
    <view class="voice-hint" wx:elif="{{!recognizing}}">按住说话，记一笔</view>
    <view class="voice-hint recording-hint" wx:else>正在听…说完了松手</view>
    <view class="voice-btn {{recognizing ? 'pulse' : ''}} {{!voiceEnabled ? 'voice-btn-disabled' : ''}}"
          bindtouchstart="startRecord" bindtouchend="endRecord" bindtouchcancel="cancelRecord">
      <text class="voice-icon">{{recognizing ? '🔴' : '🎤'}}</text>
    </view>
    <view class="voice-result" wx:if="{{result}}">{{result}}</view>
  </view>

  <!-- 缺金额：不落库，当场追问（旧版会留一条 0 元幽灵记录，没人会发现） -->
  <view class="card ask-card" wx:if="{{amountDraft}}">
    <view class="card-title">
      {{amountMissing.length > 1 ? '有 ' + amountMissing.length + ' 笔没说金额' : '这笔多少钱？'}}
    </view>
    <view class="ask-why">
      <block wx:if="{{amountMissing.length}}">
        这句话里听出好几笔，其中以下几笔没听出金额，<text class="ask-strong">一笔都没记</text>——
      </block>
      <block wx:else>
        这句话里没听出金额，<text class="ask-strong">没有记进账本</text>——
      </block>
      补上我就记。
    </view>
    <!-- 多笔缺金额：先把缺的列清楚，界面上按第一笔追问 -->
    <view class="ask-missing" wx:if="{{amountMissing.length}}">
      <view class="ask-missing-item" wx:for="{{amountMissing}}" wx:key="index">
        · {{item.item}}（{{item.customer || '散客'}}，{{item.trans_type === 'income' ? '收入' : '支出'}}）
      </view>
    </view>
    <view class="parsed-grid">
      <view class="parsed-item">
        <text class="parsed-label">顾客</text>
        <text class="parsed-value">{{amountDraft.customer || '散客'}}</text>
      </view>
      <view class="parsed-item">
        <text class="parsed-label">事由</text>
        <text class="parsed-value">{{amountDraft.item}}</text>
      </view>
      <view class="parsed-item">
        <text class="parsed-label">方向</text>
        <text class="parsed-value">{{amountDraft.trans_type === 'income' ? '收入' : '支出'}}</text>
      </view>
      <view class="parsed-item">
        <text class="parsed-label">分类</text>
        <text class="parsed-value">{{amountDraft.category}}</text>
      </view>
    </view>
    <view class="ask-row">
      <input class="ask-input" type="digit" placeholder="填金额，如 12.5"
             value="{{amountInput}}" bindinput="onAmountInput"
             confirm-type="done" bindconfirm="confirmAmount" />
      <view class="ask-btn" bindtap="confirmAmount">记下</view>
    </view>
    <view class="ask-cancel" bindtap="cancelAmount">这次不记了</view>
  </view>

  <!-- 解析结果 -->
  <view class="card" wx:if="{{parsed}}">
    <view class="card-title">{{amountDraft ? '待补金额' : '已记下'}}</view>
    <view class="type-badge {{parsed.trans_type === 'income' ? 'badge-income' : 'badge-expense'}}">
      {{parsed.trans_type === 'income' ? '收入' : '支出'}}
    </view>
    <view class="parsed-grid">
      <view class="parsed-item">
        <text class="parsed-label">顾客</text>
        <text class="parsed-value">{{parsed.customer || '散客'}}</text>
      </view>
      <view class="parsed-item">
        <text class="parsed-label">事由</text>
        <text class="parsed-value">{{parsed.item}}</text>
      </view>
      <view class="parsed-item">
        <text class="parsed-label">金额</text>
        <text class="parsed-value">{{parsed.amount != null ? parsed.amount + ' 元' : '未提'}}</text>
      </view>
      <view class="parsed-item">
        <text class="parsed-label">分类</text>
        <text class="parsed-value">{{friendlyCategory || parsed.category}}</text>
      </view>
      <view class="parsed-item" wx:if="{{voucher}}">
        <text class="parsed-label">凭证</text>
        <text class="parsed-value voucher-no">{{voucher.voucher_no}}（借:{{voucher.debit}} / 贷:{{voucher.credit}}）</text>
      </view>
    </view>
    <view class="tag" wx:for="{{parsed.tagsArr}}" wx:key="index">{{item}}</view>
  </view>

  <!-- 我这么理解的，对吗？—— AI 理解错了当场就能改，不用等到月底对账 -->
  <view class="card recorded-card" wx:if="{{recordedList.length}}">
    <view class="card-title">
      {{multi ? '这句话我听出 ' + recordedList.length + ' 笔，对吗？' : '我这么记的，对吗？'}}
    </view>
    <view class="rec-item-row" wx:for="{{recordedList}}" wx:key="transaction_id">
      <view class="rec-line">
        <text class="rec-amount {{item.trans_type === 'income' ? 'in' : 'out'}}">
          {{item.trans_type === 'income' ? '+' : '-'}}{{item.amount}}
        </text>
        <text class="rec-item">{{item.item}}</text>
      </view>
      <view class="rec-meta">
        {{item.customer || '散客'}} · {{item.friendly_category || item.category}}
        <text wx:if="{{item.category_normalized}}" class="rec-note">
          （原话是「{{item.raw_category}}」，已归到「{{item.category}}」）
        </text>
      </view>
      <view class="rec-actions">
        <view class="rec-fix" data-index="{{index}}" bindtap="fixRecorded">这条记错了？改</view>
      </view>
    </view>
  </view>

  <!-- 手动输入兜底 -->
  <view class="card">
    <view class="card-title">不方便说话？直接打字</view>
    <textarea class="manual-input" placeholder="比如：李师傅拿了两斤猪肉，38块" 
              value="{{manualText}}" bindinput="onManualInput" maxlength="100"></textarea>
    <view class="btn-primary manual-btn" bindtap="submitManual">记一笔</view>
  </view>

  <tabbar current="{{0}}" />
</view>
