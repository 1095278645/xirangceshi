/* pages/books/books.wxss 账本 */
.page { padding: 16rpx 24rpx 140rpx; }

.seg {
  display: flex; background: #fff; border-radius: 16rpx;
  padding: 8rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.seg-item {
  flex: 1; text-align: center; padding: 14rpx 0;
  font-size: 28rpx; color: #666; border-radius: 12rpx;
}
.seg-item.active { background: #B4532A; color: #fff; font-weight: 600; }

.card {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.card-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }

.empty { color: #999; text-align: center; padding: 40rpx 0; font-size: 28rpx; }

/* 流水 */
.txn { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f3f3f3; }
.txn:last-child { border-bottom: none; }
.txn-main { flex: 1; min-width: 0; }
.txn-item { font-size: 30rpx; color: #333; }
.txn-sub { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.txn-time { font-size: 22rpx; color: #ccc; margin-top: 4rpx; }
.txn-amount { font-size: 32rpx; font-weight: 700; margin-left: 16rpx; }
.txn-amount.income { color: #16a34a; }
.txn-amount.expense { color: #dc2626; }
/* 更正状态标记：退货冲销 / 已作废 */
.txn-flag { font-size: 20rpx; color: #b4532a; background: #fdf0e8;
  border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 10rpx; }
.txn-flag.void { color: #999; background: #f2f2f2; }

/* 算税表单 */
.row { display: flex; align-items: center; margin-bottom: 16rpx; }
.row-label { width: 220rpx; font-size: 28rpx; color: #555; }
.row-input { flex: 1; border: 1rpx solid #e5e5e5; border-radius: 12rpx; padding: 12rpx 16rpx; font-size: 28rpx; }
.row-radio { margin-right: 40rpx; font-size: 28rpx; }
.btn {
  background: #B4532A; color: #fff; font-size: 28rpx; border-radius: 12rpx;
  margin-top: 8rpx; width: 100%;
}
.btn[disabled] { background: #d9a98e; color: #fff; }

.result {
  margin-top: 20rpx; padding: 20rpx; background: #faf5f1; border-radius: 12rpx;
  font-size: 28rpx; color: #333; line-height: 1.8;
}
.num { font-weight: 700; color: #B4532A; }
.num.zero { color: #16a34a; }
.note { font-size: 24rpx; color: #999; }

/* 经营洞察的「重新分析」入口：放在卡片标题行右侧 */
.insight-refresh {
  float: right;
  font-size: 24rpx;
  font-weight: 400;
  color: #B4532A;
  padding: 4rpx 14rpx;
  border: 1rpx solid #B4532A;
  border-radius: 20rpx;
}

.insight-refresh.disabled { color: #bbb; border-color: #ddd; }

/* ===== 资金健康 / 库存 / 发票 三块新增样式 ===== */

/* 现金流逐月预测 */
.fin-month { padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.fin-month:last-child { border-bottom: none; }
.fin-month-head { display: flex; justify-content: space-between; align-items: center; }
.fin-month-head text:first-child { font-size: 28rpx; color: #444; }
.fin-bal { font-size: 30rpx; font-weight: 700; }
.fin-bal.pos { color: #16a34a; }
.fin-bal.neg { color: #d64545; }

/* 行内「计划 vs 实际」等两列布局（store 页的同名类是页面级作用域，这里要独立定义） */
.dim-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5;
}
.dim-row:last-child { border-bottom: none; }
.dim-name { font-size: 27rpx; color: #666; }
.dim-level { font-size: 27rpx; color: #333; font-weight: 600; }

/* 列表行尾操作（删 / 结清 / 作废） */
.row-del {
  font-size: 24rpx; color: #d64545; padding: 6rpx 16rpx;
  border: 1rpx solid #f0c9c9; border-radius: 18rpx; margin-left: 12rpx;
}

/* picker 显示的当前值 */
.picker-val { font-size: 28rpx; color: #333; }

/* 库存行的 进/出/盘/删 */
.stock-acts { display: flex; align-items: center; }
.stock-acts .act {
  font-size: 24rpx; color: #B4532A; padding: 6rpx 14rpx; margin-left: 8rpx;
  border: 1rpx solid #e8cdbd; border-radius: 18rpx;
}
.stock-acts .act.del { color: #d64545; border-color: #f0c9c9; }

/* 发票「作废」标记 */
.void-badge {
  font-size: 20rpx; color: #d64545; background: #fbe9e9;
  padding: 2rpx 10rpx; border-radius: 10rpx; margin-left: 8rpx;
}

/* 科目表 */
.cat-row { display: flex; padding: 10rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.cat-row:last-child { border-bottom: none; }
.cat-code { width: 160rpx; font-size: 26rpx; color: #B4532A; font-family: monospace; }
.cat-name { flex: 1; font-size: 28rpx; color: #444; }