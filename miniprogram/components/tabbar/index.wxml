<view class="tabbar">
  <view class="tab-item {{current === 0 ? 'active' : ''}}" data-index="0" bindtap="go">
    <text class="tab-icon">🗣️</text>
    <text class="tab-label">记账</text>
  </view>
  <view class="tab-item {{current === 1 ? 'active' : ''}}" data-index="1" bindtap="go">
    <text class="tab-icon">❤️</text>
    <text class="tab-label">熟客</text>
  </view>
  <view class="tab-item {{current === 2 ? 'active' : ''}}" data-index="2" bindtap="go">
    <text class="tab-icon">✍️</text>
    <text class="tab-label">文案</text>
  </view>
  <view class="tab-item {{current === 3 ? 'active' : ''}}" data-index="3" bindtap="go">
    <text class="tab-icon">📒</text>
    <text class="tab-label">账本</text>
  </view>
  <view class="tab-item {{current === 4 ? 'active' : ''}}" data-index="4" bindtap="go">
    <text class="tab-icon">⚙️</text>
    <text class="tab-label">设置</text>
  </view>
</view>