/* components/tabbar/index.wxss */
.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #b9ab9c;
}

.tab-item.active {
  color: #b4532a;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 48rpx;
}

.tab-label {
  font-size: 22rpx;
  margin-top: 2rpx;
}