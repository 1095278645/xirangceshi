# 巷子里的 AI 掌柜 · 反向代理配置（Caddy 2）
#
# SITE_ADDRESS 由 deploy/.env 提供：
#   有已备案域名 → shop.example.com   → 自动申请并续期 Let's Encrypt 证书，HTTP 自动跳 HTTPS
#   只有公网 IP   → :80               → 仅 HTTP（浏览器语音需 HTTPS，见部署文档「免备案」分支）
#
# 想让 Let's Encrypt 在证书到期前发提醒邮件，把下面两行的注释去掉并改成你的邮箱
# （注意：不能写成空值，否则 Caddy 会因为 email 缺参数而启动失败）：
# {
# 	email you@example.com
# }

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# 不信任客户端自带的 X-Forwarded-For：Caddy 默认就会用「直连客户端 IP」覆盖该头
	# （未配置 trusted_proxies 时不采信上游传入的值），所以服务端限流拿到的是真实 IP。
	# 注意：本项目早前版本在这里写过 header_up/timeouts，两者都不需要——
	# timeouts 不是合法的站点级指令，会让 Caddy 直接启动失败（线上实测踩过）。
	reverse_proxy shopkeeper:8000

	# 不向外泄露服务端软件版本
	header {
		-Server
	}
}
